import array;

int main() {
    int values[2048];
    ulong state = 13;
    long checksum = 0;
    for (int run = 0; run < 900; run++) {
        for (int i = 0; i < values.length; i++) {
            state = state * 6364136223846793005 + 1442695040888963407;
            values[i] = (int)(state >> 33);
        }
        values.sort();
        if (values.first > values.last) {
            return 1;
        }
        checksum += values[1024];
    }
    return checksum == 967282840248 ? 0 : 2;
}
