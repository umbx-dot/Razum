import stdio;

int main() {
    int size = 1200;
    long inside = 0;
    for (int row = 0; row < size; row++) {
        double ci = 2.0 * row / size - 1.0;
        for (int column = 0; column < size; column++) {
            double cr = 2.5 * column / size - 2.0;
            double zr = 0.0;
            double zi = 0.0;
            int steps = 0;
            while (steps < 200 && zr * zr + zi * zi <= 4.0) {
                double next = zr * zr - zi * zi + cr;
                zi = 2.0 * zr * zi + ci;
                zr = next;
                steps++;
            }
            if (steps == 200) {
                inside++;
            }
        }
    }
    print(inside);
    return 0;
}
