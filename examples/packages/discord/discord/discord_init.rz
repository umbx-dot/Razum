import discord.types;
import text;

bool discord_init(DiscordBot *bot, string token) {
    if (bot == null || bot.running || length(token) == 0 || length(token) >= bot.token.length) { return false; }
    for (long index = 0; token[index] != "\0"; index++) {
        char ch = token[index];
        if (!((ch >= "A" && ch <= "Z") || (ch >= "a" && ch <= "z") || (ch >= "0" && ch <= "9") ||
              ch == "." || ch == "_" || ch == "-")) { return false; }
    }
    copy(bot.token, token);
    bot.sequence = -1;
    return true;
}
