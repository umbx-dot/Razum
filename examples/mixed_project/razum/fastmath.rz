struct Stats {
    long minimum;
    long maximum;
    double average;
}

export long fibonacci(int n) {
    long previous = 0;
    long current = 1;
    for (int i = 0; i < n; i++) {
        long next = previous + current;
        previous = current;
        current = next;
    }
    return previous;
}

export void stats(long values[], Stats result) {
    result.minimum = values[0];
    result.maximum = values[0];
    long total = 0;
    for (int i = 0; i < values.length; i++) {
        long value = values[i];
        total += value;
        result.minimum = value < result.minimum ? value : result.minimum;
        result.maximum = value > result.maximum ? value : result.maximum;
    }
    result.average = (double)total / values.length;
}
