import stdio;
import text;

long perturb(long *stamp, long value) {
    *stamp += 1;
    return (*stamp * 29) ^ value;
}

long hot_registers(long rounds, long a, long b, long c, long d, long e, long f, long g) {
    long left = 2;
    long right = 3;
    long stamp = 0;
    for (long i = 0; i < rounds; i++) {
        left = (left * 1664525 + right) & 0x00ffffff;
        right = ((right ^ left) + i) & 0x00ffffff;
        if ((i & 65535) == 0) {
            right ^= perturb(&stamp, i);
        }
    }
    return a + b + c + d + e + f + g + left + right + stamp;
}

long tail_with_pressure(long remaining) {
    if (remaining <= 0) {
        return 0;
    }
    long a = 0;
    long b = 1;
    long c = 2;
    long d = 3;
    long e = 4;
    long f = 5;
    long g = 6;
    while (a < 2) {
        b += c;
        c += d;
        d += e;
        e += f;
        f += g;
        g += b;
        a++;
    }
    return tail_with_pressure(remaining - 1 - ((a ^ b ^ c ^ d ^ e ^ f ^ g) & 3));
}

int main(string args[]) {
    long rounds = args.length > 1 ? parse_int(args[1]) : 1000;
    print(hot_registers(rounds, 11, 13, 17, 19, 23, 29, 31) + tail_with_pressure(10));
    return 0;
}
