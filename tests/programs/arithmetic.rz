import stdio;

int main() {
    int a = 10;
    int b = 3;
    print(a + b);
    print(a - b);
    print(a * b);
    print(a / b);
    print(a % b);
    print(-a / b);
    print(-a % b);
    print(a + b * 2 - (a - b) * 3);
    a += 5;
    a -= 2;
    a *= 3;
    a /= 4;
    a %= 5;
    print(a);
    a++;
    a++;
    a--;
    print(a);
    print(9223372036854775807);
    print(-9223372036854775808);
    print(0x7F);
    print(1 < 2);
    print(2 <= 1);
    print(3 == 3);
    print(3 != 3);
    print(!0);
    print(!5);
    print(1 && 0);
    print(0 || 7);
    return 0;
}
