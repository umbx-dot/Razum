import math.integer;
import stdio;

long trace;

long record_argument(long value) {
    trace = trace * 10 + value;
    return value;
}

long choose_argument(bool first, long a, long b) {
    if (first) {
        return a;
    }
    return b;
}

long helper_loop(long count, long cap) {
    long sum = 0;
    for (long i = 0; i < count; i++) {
        sum += min(i, cap);
    }
    return sum;
}

long invariant_divide(long count, long numerator, long denominator) {
    long total = 0;
    for (long i = 0; i < count; i++) {
        long ratio = numerator / denominator;
        if (i == 1) {
            continue;
        }
        total += ratio + i;
    }
    return total;
}

long changing_divisor(long denominator) {
    long total = 0;
    for (; denominator > 0; denominator--) {
        long ratio = 24 / denominator;
        total += ratio;
    }
    return total;
}

long changing_value(long count, long numerator, long denominator) {
    long total = 0;
    while (count > 0) {
        long ratio = numerator / denominator;
        ratio++;
        total += ratio;
        count--;
    }
    return total;
}

void reduce_denominator(long *denominator) {
    *denominator -= 1;
}

long aliased_divisor(long denominator) {
    long total = 0;
    while (denominator > 0) {
        long ratio = 24 / denominator;
        total += ratio;
        reduce_denominator(&denominator);
    }
    return total;
}

long same_address(long *base, long offset, long count) {
    long result = 0;
    while (count > 0) {
        long *at = &base[offset];
        result += *at;
        *at += 1;
        count--;
    }
    return result;
}

double rounded(double first, double small) {
    return (first + small) - first;
}

int main() {
    print(helper_loop(7, 3));
    print(invariant_divide(4, 30, 3));
    print(invariant_divide(0, 30, 0));
    print(changing_divisor(3));
    print(changing_value(3, 30, 3));
    print(aliased_divisor(3));
    long values[3] = {2, 10, 30};
    print(same_address(&values[0], 1, 3));
    print(values[1]);
    print(choose_argument(false, record_argument(5), record_argument(6)));
    print(trace);
    print(rounded(9007199254740992.0, 1.0) == 0.0);
    return 0;
}
