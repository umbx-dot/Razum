import stdio;

int main() {
    for (int i = 0; i < 10; i++) {
        if (i % 2 == 0) {
            continue;
        }
        if (i > 7) {
            break;
        }
        print(i);
    }
    int n = 0;
    while (1) {
        n++;
        if (n == 3) break;
    }
    print(n);
    int total = 0;
    for (int row = 1; row <= 3; row++) {
        for (int column = 1; column <= 3; column++) {
            if (column == 2) continue;
            total += row * column;
        }
    }
    print(total);
    int grade = 85;
    if (grade >= 90) {
        print("A");
    } else if (grade >= 80) {
        print("B");
    } else {
        print("C");
    }
    int count = 0;
    for (;;) {
        count += 2;
        if (count >= 10) break;
    }
    print(count);
    int k = 5;
    while (k > 0) k -= 2;
    print(k);
    return 0;
}
