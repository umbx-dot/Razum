import stdio;
import text;

struct Label {
    string caption;
}

int main() {
    print(length("razum"));
    print(length(""));
    print(compare("apple", "banana"));
    print(compare("pear", "pear"));
    print(compare("pear", "peach"));
    print(compare("ab", "abc"));
    print(equals("same", "same"));
    print(equals("same", "Same"));

    char buffer[16];
    print(copy(buffer, "hello"));
    print(concat(buffer, ", "));
    print(concat(buffer, "world and more"));
    print(buffer);
    print(length(buffer));

    char small[4];
    print(copy(small, "toolong"));
    print(small);

    char number[24];
    int_to_text(number, -9223372036854775807);
    print(number);
    int_to_text(number, 0);
    print(number);
    char line[32] = "total: ";
    char digits[8];
    int_to_text(digits, 42);
    concat(line, digits);
    print(line);

    print(parse_int("  -1234xyz"));
    print(parse_int("+77"));
    print(parse_int("none"));
    print(parse_double("2.5e3") + 1);

    Label empty;
    print(length(empty.caption));
    print(equals(empty.caption, ""));
    print(parse_int(empty.caption));
    copy(buffer, empty.caption);
    print(length(buffer));
    char bytes[5] = {(char)0x80, "a", (char)0x80, (char)0xff, "\0"};
    if (find_char(bytes, (char)0x80) != 0 || find_char(bytes, (char)0xff) != 3 ||
        find_char(bytes, "a") != 1 || find_char(bytes, "?") != -1 ||
        find_char(bytes, "\0") != -1 || find_char("", "a") != -1 ||
        find_char(empty.caption, "a") != -1) {
        return 1;
    }
    return 0;
}
