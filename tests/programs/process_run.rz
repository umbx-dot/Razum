// platform: windows
import stdio;
import process;

void show(ProcessResult result) {
    write_string("exit ");
    write_long(result.exit_code);
    write_string(result.timed_out ? " timed out" : "");
    write_string(result.truncated ? " truncated" : "");
    write_string(": ");
    for (long index = 0; index < result.output_length; index++) {
        if (result.output[index] != '\r') {
            write_char(result.output[index] == '\n' ? '|' : result.output[index]);
        }
    }
    print_line();
}

int main() {
    ProcessLimits limits;
    limits.timeout_milliseconds = 5000;
    limits.max_output = 4096;
    limits.max_memory = 256 * 1048576;
    limits.max_processes = 4;
    ProcessResult result;

    process_run(result, "cmd /c echo hello& echo to stderr 1>&2", "", "", limits);
    show(result);
    process_free(result);

    process_run(result, "cmd /c sort", "pear\napple\nfig\n", "", limits);
    show(result);
    process_free(result);

    process_run(result, "cmd /c exit 7", "", "", limits);
    show(result);
    process_free(result);

    process_run(result, "cmd /c cd", "", "C:\\Windows", limits);
    show(result);
    process_free(result);

    limits.timeout_milliseconds = 300;
    process_run(result, "cmd /c ping -n 5 127.0.0.1 >nul", "", "", limits);
    show(result);
    print(result.milliseconds < 2000);
    process_free(result);

    limits.timeout_milliseconds = 5000;
    limits.max_output = 10;
    process_run(result, "cmd /c echo 0123456789abcdef", "", "", limits);
    print(result.truncated);
    print(result.output);
    process_free(result);

    print(process_run(result, "no_such_program_razum.exe", "", "", limits));
    print(result.started);
    process_free(result);
    return 0;
}
