import crypt;
import stdio;

int main() {
    byte key[32];
    byte signature[64];
    if (hex_decode(key, "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a") != 32 ||
        hex_decode(signature, "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b") != 64) { return 1; }
    if (!ed25519_verify(key, signature, null, 0)) { return 2; }
    signature[0] ^= 1;
    if (ed25519_verify(key, signature, null, 0)) { return 3; }
    signature[0] ^= 1;
    signature[63] |= 0x80;
    if (ed25519_verify(key, signature, null, 0)) { return 4; }
    if (hex_decode(key, "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c") != 32 ||
        hex_decode(signature, "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00") != 64) { return 5; }
    byte message[1] = {0x72};
    if (!ed25519_verify_parts(key, signature, null, 0, &message[0], 1)) { return 6; }
    message[0] = 0x73;
    if (ed25519_verify(key, signature, &message[0], 1)) { return 7; }
    byte identity[32] = {1};
    byte zero_signature[64] = {1};
    if (ed25519_verify(identity, zero_signature, null, 0)) { return 8; }
    print("ed25519 verified");
    return 0;
}
