import stdio;

double area(double radius) {
    return 3.14159 * radius * radius;
}

int main() {
    double x = 1.5;
    double y = 2;
    print(x + y);
    print(x * y);
    print(y / 4);
    print(7 / 2.0);
    print(-x);
    print(0.1 + 0.2);
    print(1 / 3.0);
    print(1e20 * 3);
    print(1e-5 + 0);
    print(area(2));
    x += 1;
    x *= 2;
    x -= 0.5;
    x /= 3;
    print(x);
    x++;
    print(x);
    print((int)x);
    print((int)-2.7);
    print((double)7 / 2);
    print(x > 2.4);
    print(x < 2.4);
    print(x == 2.5);
    print(x != 2.5);
    print(x >= 2.5 && x <= 2.5);
    double zero = 0.0;
    double undefined = zero / zero;
    print(undefined);
    print(undefined == undefined);
    print(undefined != undefined);
    print(undefined < 1.0);
    print(1.0 / zero);
    print(-1.0 / zero);
    return 0;
}
