file(GLOB_RECURSE library_files RELATIVE "${LIBRARIES}" "${LIBRARIES}/*.rz" "${LIBRARIES}/*.asm")
set(ordered_files "")
foreach(relative IN LISTS library_files)
    string(REGEX REPLACE "^gui/([^/]+)/windows/" "gui/\\1/" order "${relative}")
    list(APPEND ordered_files "${order}|${relative}")
endforeach()
list(SORT ordered_files)
set(content "#include \"embedded/embedded_files.h\"\n\n")
set(table "")
set(index 0)
foreach(entry IN LISTS ordered_files)
    string(REGEX REPLACE "^[^|]+[|]" "" relative "${entry}")
    file(READ "${LIBRARIES}/${relative}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND content "static const char file_${index}[] = {${bytes}0x00};\n")
    string(APPEND table "    {\"${relative}\", file_${index}},\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND content "\nconst EmbeddedFile EMBEDDED_FILES[] = {\n${table}    {0, 0},\n};\n\n")
string(APPEND content "const int EMBEDDED_FILE_COUNT = ${index};\n")
file(WRITE "${OUTPUT}" "${content}")
