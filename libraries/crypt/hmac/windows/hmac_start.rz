import windows;
import crypt.hash;

bool hmac_start(Hasher hasher, Hash kind, byte *key, long key_length) {
    hasher.kind = kind;
    hasher.handle = 0;
    if (key_length < 0 || key_length > 0xFFFFFFFF) {
        return false;
    }
    return BCryptCreateHash(hmac_algorithm(kind), &hasher.handle, null, 0, key, (uint)key_length, 0) == STATUS_SUCCESS;
}
