import crypt.encoding;

long uuid4(char target[]) {
    target[0] = "\0";
    byte bytes[16];
    char digits[33];
    if (target.length < 37 || !secure_bytes(bytes, 16)) {
        return -1;
    }
    bytes[6] = (byte)((bytes[6] & 0x0F) | 0x40);
    bytes[8] = (byte)((bytes[8] & 0x3F) | 0x80);
    hex_encode(digits, bytes, 16);
    int out = 0;
    for (int i = 0; i < 32; i++) {
        if (i == 8 || i == 12 || i == 16 || i == 20) {
            target[out] = "-";
            out++;
        }
        target[out] = digits[i];
        out++;
    }
    target[out] = "\0";
    return out;
}
