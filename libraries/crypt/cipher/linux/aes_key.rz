struct AesKey {
    byte rounds_keys[240];
    int rounds;
    uint features;
}

bool aes_expand(AesKey key, byte *bytes, long length) {
    if (length != 16 && length != 24 && length != 32) {
        return false;
    }
    aes_prepare();
    int words = (int)(length / 4);
    key.rounds = words + 6;
    key.features = aes_cpu_features();
    int total = 4 * (key.rounds + 1);
    for (int index = 0; index < length; index++) {
        key.rounds_keys[index] = bytes[index];
    }
    int constant = 1;
    for (int word = words; word < total; word++) {
        byte previous[4];
        for (int part = 0; part < 4; part++) {
            previous[part] = key.rounds_keys[4 * (word - 1) + part];
        }
        if (word % words == 0) {
            byte first = previous[0];
            previous[0] = (byte)(aes_forward[previous[1]] ^ constant);
            previous[1] = aes_forward[previous[2]];
            previous[2] = aes_forward[previous[3]];
            previous[3] = aes_forward[first];
            constant = aes_double(constant);
        } else if (words > 6 && word % words == 4) {
            for (int part = 0; part < 4; part++) {
                previous[part] = aes_forward[previous[part]];
            }
        }
        for (int part = 0; part < 4; part++) {
            key.rounds_keys[4 * word + part] = (byte)(key.rounds_keys[4 * (word - words) + part] ^ previous[part]);
        }
    }
    return true;
}
