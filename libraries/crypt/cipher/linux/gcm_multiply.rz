void gcm_multiply(ulong value[], ulong key[], bool hardware) {
    if (hardware) {
        gcm_multiply_hardware(&value[0], &key[0]);
        return;
    }
    ulong high = 0;
    ulong low = 0;
    ulong vector_high = key[0];
    ulong vector_low = key[1];
    for (int bit = 0; bit < 128; bit++) {
        ulong word = bit < 64 ? value[0] : value[1];
        if (((word >> (63 - bit % 64)) & 1) != 0) {
            high = high ^ vector_high;
            low = low ^ vector_low;
        }
        bool carry = (vector_low & 1) != 0;
        vector_low = (vector_low >> 1) | (vector_high << 63);
        vector_high = vector_high >> 1;
        if (carry) {
            vector_high = vector_high ^ 0xE100000000000000;
        }
    }
    value[0] = high;
    value[1] = low;
}
