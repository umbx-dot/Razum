void gcm_tag(AesKey key, byte *nonce, byte *aad, long aad_length, byte *cipher, long length, byte *tag) {
    byte zero[16];
    for (int i = 0; i < 16; i++) {
        zero[i] = 0;
    }
    byte encrypted_zero[16];
    aes_encrypt_block(key, &zero[0], &encrypted_zero[0]);
    ulong hash_key[2];
    hash_key[0] = 0;
    hash_key[1] = 0;
    for (int i = 0; i < 16; i++) {
        if (i < 8) {
            hash_key[0] = (hash_key[0] << 8) | (ulong)encrypted_zero[i];
        } else {
            hash_key[1] = (hash_key[1] << 8) | (ulong)encrypted_zero[i];
        }
    }
    ulong hash[2];
    hash[0] = 0;
    hash[1] = 0;
    bool hardware = (key.features & GHASH_SIMD) == GHASH_SIMD;
    gcm_absorb(hash, hash_key, aad, aad_length, hardware);
    gcm_absorb(hash, hash_key, cipher, length, hardware);
    hash[0] = hash[0] ^ ((ulong)aad_length * 8);
    hash[1] = hash[1] ^ ((ulong)length * 8);
    gcm_multiply(hash, hash_key, hardware);
    byte first[16];
    for (int i = 0; i < 12; i++) {
        first[i] = nonce[i];
    }
    first[12] = 0;
    first[13] = 0;
    first[14] = 0;
    first[15] = 1;
    byte mask[16];
    aes_encrypt_block(key, &first[0], &mask[0]);
    for (int i = 0; i < 16; i++) {
        ulong word = i < 8 ? hash[0] : hash[1];
        tag[i] = (byte)(mask[i] ^ (byte)(word >> (8 * (7 - i % 8))));
    }
}
