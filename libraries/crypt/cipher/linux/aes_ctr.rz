long aes_ctr(byte target[], byte *key, long key_length, byte *counter, byte *data, long length) {
    if (length < 0 || target.length < length) {
        return -1;
    }
    AesKey expanded;
    if (!aes_expand(expanded, key, key_length)) {
        return -1;
    }
    byte block[AES_BLOCK_SIZE];
    for (int i = 0; i < AES_BLOCK_SIZE; i++) {
        block[i] = counter[i];
    }
    byte stream[AES_BLOCK_SIZE];
    for (long at = 0; at < length; at += AES_BLOCK_SIZE) {
        aes_encrypt_block(expanded, &block[0], &stream[0]);
        for (int i = 0; i < AES_BLOCK_SIZE && at + i < length; i++) {
            target[at + i] = (byte)(data[at + i] ^ stream[i]);
        }
        for (int i = AES_BLOCK_SIZE - 1; i >= 0; i--) {
            block[i]++;
            if (block[i] != 0) {
                break;
            }
        }
    }
    return length;
}
