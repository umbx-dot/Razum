import windows;

long aes_ctr(byte target[], byte *key, long key_length, byte *counter, byte *data, long length) {
    if (length < 0 || target.length < length) {
        return -1;
    }
    long handle = aes_key(BCRYPT_AES_ECB_ALG_HANDLE, key, key_length);
    if (handle == 0) {
        return -1;
    }
    byte block[AES_BLOCK_SIZE];
    for (int i = 0; i < AES_BLOCK_SIZE; i++) {
        block[i] = counter[i];
    }
    byte stream[4096];
    bool ok = true;
    for (long done = 0; ok && done < length; done += stream.length) {
        long part = length - done < stream.length ? length - done : stream.length;
        long blocks = (part + AES_BLOCK_SIZE - 1) / AES_BLOCK_SIZE;
        for (long b = 0; b < blocks; b++) {
            for (int i = 0; i < AES_BLOCK_SIZE; i++) {
                stream[AES_BLOCK_SIZE * b + i] = block[i];
            }
            for (int i = AES_BLOCK_SIZE - 1; i >= 0; i--) {
                block[i]++;
                if (block[i] != 0) {
                    break;
                }
            }
        }
        uint written = 0;
        ok = BCryptEncrypt(handle, stream, (uint)(AES_BLOCK_SIZE * blocks), null, null, 0, stream, (uint)stream.length,
                           &written, 0) == STATUS_SUCCESS;
        for (long i = 0; ok && i < part; i++) {
            target[done + i] = (byte)(data[done + i] ^ stream[i]);
        }
    }
    BCryptDestroyKey(handle);
    return ok ? length : -1;
}
