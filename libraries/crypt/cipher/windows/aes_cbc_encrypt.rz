import windows;

long aes_cbc_encrypt(byte target[], byte *key, long key_length, byte *iv, byte *data, long length) {
    long size = (length / AES_BLOCK_SIZE + 1) * AES_BLOCK_SIZE;
    if (length < 0 || size > 0xFFFFFFFF || target.length < size) {
        return -1;
    }
    long handle = aes_key(BCRYPT_AES_CBC_ALG_HANDLE, key, key_length);
    if (handle == 0) {
        return -1;
    }
    byte chain[AES_BLOCK_SIZE];
    for (int i = 0; i < AES_BLOCK_SIZE; i++) {
        chain[i] = iv[i];
    }
    uint written = 0;
    int status = BCryptEncrypt(handle, data, (uint)length, null, chain, AES_BLOCK_SIZE, target, (uint)size, &written,
                               BCRYPT_BLOCK_PADDING);
    BCryptDestroyKey(handle);
    return status == STATUS_SUCCESS ? written : -1;
}
