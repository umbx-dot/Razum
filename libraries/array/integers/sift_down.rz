void array_sift_down_T(T *items, long root, long count) {
    while (true) {
        long child = 2 * root + 1;
        if (child >= count) {
            return;
        }
        if (child + 1 < count && items[child] < items[child + 1]) {
            child++;
        }
        if (items[root] >= items[child]) {
            return;
        }
        T kept = items[root];
        items[root] = items[child];
        items[child] = kept;
        root = child;
    }
}
