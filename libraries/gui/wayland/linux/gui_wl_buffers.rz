import gui.state;
import linux;

bool gui_wl_buffers() {
    gui_wl_drop_buffers();
    int width = gui.buffer_width;
    int height = gui.buffer_height + GUI_TITLE_HEIGHT;
    int pixels = width * height * 4;
    int size = pixels * 2;
    long fd = system_call(SYS_MEMFD_CREATE, (long)"razum-gui", MFD_CLOEXEC, 0, 0);
    if (fd < 0) {
        return false;
    }
    if (system_call(SYS_FTRUNCATE, fd, size, 0, 0) < 0) {
        system_call(SYS_CLOSE, fd, 0, 0, 0);
        return false;
    }
    long address = system_call6(SYS_MMAP, 0, size, PROT_READ_WRITE, MAP_SHARED, fd, 0);
    if (address < 0) {
        system_call(SYS_CLOSE, fd, 0, 0, 0);
        return false;
    }
    uint pool = gui_desktop.wl_next;
    gui_desktop.wl_next++;
    gui_desktop.wl_bytes = size;
    gui_desktop.wl_buffers[0].address = address;
    gui_desktop.wl_buffers[1].address = address + pixels;
    bool good = gui_wl_send_fd(gui_desktop.wl_shm, pool, size, fd);
    system_call(SYS_CLOSE, fd, 0, 0, 0);
    for (int i = 0; i < gui_desktop.wl_buffers.length && good; i++) {
        uint id = gui_desktop.wl_next;
        gui_desktop.wl_next++;
        gui_desktop.wl_buffers[i].id = id;
        uint buffer[8] = {0, 0, id, (uint)(i * pixels), (uint)width, (uint)height, (uint)(width * 4), 1};
        good = gui_wl_request(pool, 0, buffer);
    }
    uint destroy[2];
    good = good && gui_wl_request(pool, 1, destroy);
    if (good) {
        gui_desktop.wl_width = width;
        gui_desktop.wl_height = height;
    }
    return good;
}
