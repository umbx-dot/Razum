uint gui_xkb_symbol(char *text, int length) {
    if (length == 1) {
        return (uint)text[0];
    }
    if (length >= 5 && length <= 7 && text[0] == "U") {
        uint value = 0;
        for (int i = 1; i < length; i++) {
            uint digit = (uint)text[i];
            if (digit >= 48 && digit <= 57) {
                digit -= 48;
            } else {
                digit |= 32;
                if (digit < 97 || digit > 102) {
                    return 0;
                }
                digit -= 87;
            }
            value = value * 16 + digit;
        }
        return value <= 0x10FFFF ? 0x1000000 | value : 0;
    }
    uint key = gui_xkb_hash(text, length);
    int left = 0;
    int right = gui_xkb_table.length / 2;
    while (left < right) {
        int middle = (left + right) / 2;
        if (gui_xkb_table[middle * 2] < key) {
            left = middle + 1;
        } else {
            right = middle;
        }
    }
    if (left < gui_xkb_table.length / 2 && gui_xkb_table[left * 2] == key) {
        return gui_xkb_table[left * 2 + 1];
    }
    return 0;
}
