import gui.state;
import gui.render;

void gui_finish_frame() {
    if (gui.pressed && !gui.focus_claimed) {
        gui.focus = -1;
    }
    if (!gui.mouse_down) {
        gui.active = -1;
    }
    if (gui.pressed || gui.released || gui.event_count > 0) {
        gui.animating = true;
    }
    gui_render();
    gui_present();
    gui.pressed = false;
    gui.released = false;
    gui.event_count = 0;
}
