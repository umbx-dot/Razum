import gui.state;
import gui.wayland;
import gui.x11;
import text;

bool gui_open(string title, int width, int height) {
    if (gui.commands != null || width <= 0 || height <= 0 || width > GUI_MAX_EDGE || height > GUI_MAX_EDGE) {
        return false;
    }
    gui.width = width;
    gui.height = height;
    if (!gui_start()) {
        gui_close();
        return false;
    }
    copy(gui_desktop.title, title);
    gui_desktop.backend = GUI_WAYLAND;
    if (!gui_wl_open(gui_desktop.title)) {
        gui_disconnect();
        gui.quit = false;
        gui.width = width;
        gui.height = height;
        gui_desktop.backend = GUI_X11;
        if (!gui_x11_open(title)) {
            gui_close();
            return false;
        }
    }
    if (!gui_resize_buffer()) {
        gui_close();
        return false;
    }
    return true;
}
