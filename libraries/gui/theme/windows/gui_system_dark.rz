import gui.state;

import windows;

bool gui_system_dark() {
    long key = 0;
    if (RegOpenKeyExA(HKEY_CURRENT_USER, "Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize", 0, KEY_READ, &key) != 0) {
        return false;
    }
    char data[4];
    uint size = 4;
    uint type = 0;
    int status = RegQueryValueExA(key, "AppsUseLightTheme", 0, &type, data, &size);
    RegCloseKey(key);
    return status == 0 && data[0] == "\0";
}
