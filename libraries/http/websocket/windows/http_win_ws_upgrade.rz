import windows;

int http_win_ws_upgrade(HttpWebSocket *socket, long request, int timeout_ms, HttpWinWsState *ws) {
    HttpWinState state;
    state.ready = CreateEventW(0, 0, 0, 0);
    state.closed = CreateEventW(0, 0, 0, 0);
    state.deadline = GetTickCount64() + (ulong)timeout_ms;
    long context = (long)&state;
    uint disabled = HTTP_WIN_NO_COOKIES_REDIRECTS_OR_AUTH;
    uint events = HTTP_WIN_HANDLE_CLOSING | HTTP_WIN_HEADERS_AVAILABLE | HTTP_WIN_REQUEST_ERROR | HTTP_WIN_SEND_COMPLETE;
    bool callback = state.ready != 0 && state.closed != 0 &&
                    WinHttpSetOption(request, HTTP_WIN_DISABLED_FEATURES, (void *)&disabled, 4) != 0 &&
                    WinHttpSetOption(request, HTTP_WIN_UPGRADE_WEBSOCKET, null, 0) != 0 &&
                    WinHttpSetOption(request, HTTP_WIN_CONTEXT, (void *)&context, 8) != 0 &&
                    WinHttpSetStatusCallback(request, http_win_callback, events, 0) != -1;
    int result = callback ? http_win_wait(&state, WinHttpSendRequest(request, 0, 0, 0, 0, 0, context)) : HTTP_CLIENT_BACKEND;
    if (result == 0) { result = http_win_wait(&state, WinHttpReceiveResponse(request, 0)); }
    uint status = 0;
    uint size = 4;
    if (result == 0 && (WinHttpQueryHeaders(request, HTTP_WIN_NUMERIC_STATUS, 0, (void *)&status, &size, 0) == 0 || status != 101)) {
        result = HTTP_CLIENT_PROTOCOL;
    }
    if (result == 0) {
        socket.socket = WinHttpWebSocketCompleteUpgrade(request, (long)ws);
        if (socket.socket == 0) { result = http_win_error(GetLastError()); }
    }
    WinHttpCloseHandle(request);
    if (callback) { WaitForSingleObject(state.closed, 0xffffffff); }
    if (state.ready != 0) { CloseHandle(state.ready); }
    if (state.closed != 0) { CloseHandle(state.closed); }
    if (result == 0) {
        uint notifications = HTTP_WIN_HANDLE_CLOSING | HTTP_WIN_READ_COMPLETE | HTTP_WIN_WRITE_COMPLETE | HTTP_WIN_REQUEST_ERROR;
        ws.callback = WinHttpSetStatusCallback(socket.socket, http_win_ws_callback, notifications, 0) != -1;
        if (!ws.callback) { result = HTTP_CLIENT_BACKEND; }
    }
    return result;
}
