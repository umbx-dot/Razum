import text;

bool http_client_header(HttpClientResponse *response, string key, char output[]) {
    if (response == null || output.length == 0) { return false; }
    output[0] = "\0";
    string headers = (string)response.headers;
    long size = length(headers);
    long start = 0;
    while (start < size) {
        long end = start;
        long split = -1;
        while (end < size && headers[end] != "\r" && headers[end] != "\n") {
            if (split < 0 && headers[end] == ":") { split = end; }
            end++;
        }
        if (split > start && split - start < 129) {
            char name[129];
            substring(name, headers, start, split - start);
            if (equals_ignore_case(name, key)) {
                long value = split + 1;
                while (value < end && (headers[value] == " " || headers[value] == "\t")) { value++; }
                while (end > value && (headers[end - 1] == " " || headers[end - 1] == "\t")) { end--; }
                if (end - value >= output.length) { return false; }
                substring(output, headers, value, end - value);
                return true;
            }
        }
        start = end + 1;
        if (end + 1 < size && headers[end] == "\r" && headers[end + 1] == "\n") { start++; }
    }
    return false;
}
