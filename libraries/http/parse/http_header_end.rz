import http.memory;

long http_header_end(char *data, long size) {
    long position = 0;
    while (position < size) {
        long found = http_find(&data[position], size - position, "\n");
        if (found < 0) {
            return -1;
        }
        long at = position + found;
        if (at >= 3 && data[at - 1] == "\r" && data[at - 2] == "\n" && data[at - 3] == "\r") {
            return at + 1;
        }
        position = at + 1;
    }
    return -1;
}
