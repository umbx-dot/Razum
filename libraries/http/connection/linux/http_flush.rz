import http.state;
import http.memory;
import http.tls;
import linux;

void http_flush(HttpWorker *worker, HttpConnection *connection) {
    char *data = worker.output;
    long total = worker.output_used;
    if (connection.tls != null) {
        if (worker.output_used > 0 &&
            (connection.tls.state != 2 || !http_tls_seal(worker, connection, 23, (byte *)worker.output, worker.output_used))) {
            worker.output_used = 0;
            worker.sealed_used = 0;
            http_close(worker, connection);
            return;
        }
        data = worker.sealed;
        total = worker.sealed_used;
    }
    long sent = 0;
    while (sent < total) {
        long done = system_call(SYS_WRITE, connection.socket, (long)&data[sent], total - sent, 0);
        if (done == EINTR) {
            continue;
        }
        if (done == EAGAIN) {
            break;
        }
        if (done <= 0) {
            worker.output_used = 0;
            worker.sealed_used = 0;
            http_close(worker, connection);
            return;
        }
        sent += done;
    }
    worker.output_used = 0;
    worker.sealed_used = 0;
    if (sent < total) {
        connection.outgoing = new char[total - sent];
        http_copy(connection.outgoing, &data[sent], total - sent);
        connection.outgoing_used = total - sent;
        connection.outgoing_sent = 0;
        if (!http_epoll_set(worker.events, EPOLL_CTL_MOD, connection.socket, EPOLLOUT | EPOLLRDHUP, (long)connection)) {
            http_close(worker, connection);
        }
        return;
    }
    if (connection.close_after_send) {
        system_call(SYS_SHUTDOWN, connection.socket, SHUT_WR, 0, 0);
        http_close(worker, connection);
    }
}
