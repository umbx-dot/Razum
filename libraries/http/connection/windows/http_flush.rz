import http.state;
import http.memory;
import http.tls;
import windows;
import winsock;

void http_flush(HttpWorker *worker, HttpConnection *connection) {
    char *data = worker.output;
    long total = worker.output_used;
    if (connection.tls != null) {
        if (worker.output_used > 0 && (!connection.tls.ready || !http_tls_seal(worker, connection))) {
            worker.output_used = 0;
            worker.sealed_used = 0;
            http_close(connection);
            return;
        }
        data = worker.sealed;
        total = worker.sealed_used;
    }
    long sent = 0;
    while (sent < total) {
        long chunk = total - sent;
        int done = send(connection.socket, &data[sent], chunk > 0x40000000 ? 0x40000000 : (int)chunk, 0);
        if (done > 0) {
            sent += done;
        } else if (WSAGetLastError() == WSAEWOULDBLOCK) {
            break;
        } else {
            worker.output_used = 0;
            worker.sealed_used = 0;
            http_close(connection);
            return;
        }
    }
    worker.output_used = 0;
    worker.sealed_used = 0;
    if (sent < total) {
        connection.outgoing = new char[total - sent];
        http_copy(connection.outgoing, &data[sent], total - sent);
        connection.outgoing_used = total - sent;
        connection.outgoing_sent = 0;
        if (!http_post_send(connection)) {
            http_close(connection);
        }
        return;
    }
    if (connection.close_after_send) {
        shutdown(connection.socket, SD_SEND);
        http_close(connection);
        return;
    }
    if (!http_post_wait(connection)) {
        http_close(connection);
    }
}
