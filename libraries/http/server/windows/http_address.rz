import windows;
import winsock;
import text;

int http_address(string host, int port, byte address[]) {
    for (int index = 0; index < address.length; index++) {
        address[index] = 0;
    }
    char text[64];
    copy(text, host);
    if (equals(host, "localhost")) {
        copy(text, "127.0.0.1");
    } else if (equals(host, "") || equals(host, "*")) {
        copy(text, "0.0.0.0");
    } else if (starts_with(host, "[") && ends_with(host, "]")) {
        substring(text, host, 1, length(host) - 2);
    }
    address[2] = (byte)(port >> 8);
    address[3] = (byte)port;
    if (inet_pton(AF_INET, text, &address[4]) == 1) {
        address[0] = (byte)AF_INET;
        return AF_INET;
    }
    if (inet_pton(AF_INET6, text, &address[8]) == 1) {
        address[0] = (byte)AF_INET6;
        return AF_INET6;
    }
    return 0;
}
