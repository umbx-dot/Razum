import http.state;
import crypt.bytes;
import crypt.hash;
import crypt.hmac;
import crypt.kdf;
import crypt.exchange;
import crypt.sign;
import crypt.random;

bool http_tls_hello(HttpWorker *worker, HttpConnection *connection, byte *body, long length) {
    HttpTls *tls = connection.tls;
    if (length < 4 || body[0] != 1 || http_tls_number(body, 1, 3) + 4 > length) {
        return false;
    }
    long end = 4 + http_tls_number(body, 1, 3);
    long at = 4 + 2 + 32;
    long session_length = body[at];
    long session = at + 1;
    at = session + session_length;
    long suites = http_tls_number(body, at, 2);
    bool has_suite = false;
    bool has_suite12 = false;
    for (long index = 0; index < suites; index += 2) {
        long suite = http_tls_number(body, at + 2 + index, 2);
        has_suite = has_suite || suite == 0x1301;
        has_suite12 = has_suite12 || suite == 0xC02B;
    }
    at += 2 + suites;
    at += 1 + body[at];
    long extensions_end = at + 2 + http_tls_number(body, at, 2);
    at += 2;
    bool tls13 = false;
    bool has_scheme = false;
    bool has_group = false;
    long share = -1;
    while (at + 4 <= extensions_end && extensions_end <= end) {
        long kind = http_tls_number(body, at, 2);
        long size = http_tls_number(body, at + 2, 2);
        long data = at + 4;
        if (kind == 43) {
            for (long index = 1; index < 1 + body[data]; index += 2) {
                tls13 = tls13 || http_tls_number(body, data + index, 2) == 0x0304;
            }
        } else if (kind == 10) {
            for (long index = 2; index < 2 + http_tls_number(body, data, 2); index += 2) {
                has_group = has_group || http_tls_number(body, data + index, 2) == 0x001D;
            }
        } else if (kind == 13) {
            for (long index = 2; index < 2 + http_tls_number(body, data, 2); index += 2) {
                has_scheme = has_scheme || http_tls_number(body, data + index, 2) == 0x0403;
            }
        } else if (kind == 51) {
            long entry = data + 2;
            while (entry + 4 <= data + size) {
                long group = http_tls_number(body, entry, 2);
                long key_length = http_tls_number(body, entry + 2, 2);
                if (group == 0x001D && key_length == 32) {
                    share = entry + 4;
                }
                entry += 4 + key_length;
            }
        }
        at = data + size;
    }
    if (!tls13) {
        return has_suite12 && has_scheme && has_group && http_tls12_hello(worker, connection, body, end);
    }
    if (!has_suite || !has_scheme || share < 0 || session_length > 32) {
        return false;
    }
    tls.version = 13;
    hash_start(tls.transcript, Hash.SHA256);
    hash_update(tls.transcript, body, end);

    byte secret_key[32];
    byte public_key[32];
    byte shared[32];
    if (!secure_bytes(&secret_key[0], 32)) {
        return false;
    }
    x25519_public(&public_key[0], &secret_key[0]);
    x25519(&shared[0], &secret_key[0], &body[share]);

    byte message[16384];
    byte random[32];
    secure_bytes(&random[0], 32);
    long position = http_tls_put(message, 0, 2, 1);
    long length_at = position;
    position = http_tls_put(message, position, 0, 3);
    position = http_tls_put(message, position, 0x0303, 2);
    position = http_tls_put_bytes(message, position, &random[0], 32);
    position = http_tls_put(message, position, session_length, 1);
    position = http_tls_put_bytes(message, position, &body[session], session_length);
    position = http_tls_put(message, position, 0x1301, 2);
    position = http_tls_put(message, position, 0, 1);
    position = http_tls_put(message, position, 46, 2);
    position = http_tls_put(message, position, 43, 2);
    position = http_tls_put(message, position, 2, 2);
    position = http_tls_put(message, position, 0x0304, 2);
    position = http_tls_put(message, position, 51, 2);
    position = http_tls_put(message, position, 36, 2);
    position = http_tls_put(message, position, 0x001D, 2);
    position = http_tls_put(message, position, 32, 2);
    position = http_tls_put_bytes(message, position, &public_key[0], 32);
    http_tls_put(message, length_at, position - 4, 3);
    hash_update(tls.transcript, &message[0], position);
    byte header[5];
    http_tls_put(header, 0, 22, 1);
    http_tls_put(header, 1, 0x0303, 2);
    http_tls_put(header, 3, position, 2);
    http_sealed_append(worker, &header[0], 5);
    http_sealed_append(worker, &message[0], position);
    byte change[6] = {20, 3, 3, 0, 1, 1};
    http_sealed_append(worker, &change[0], 6);

    byte zeros[32];
    for (int index = 0; index < 32; index++) {
        zeros[index] = 0;
    }
    byte empty_hash[32];
    hash(Hash.SHA256, empty_hash, &zeros[0], 0);
    byte early[32];
    hkdf_extract(Hash.SHA256, early, &zeros[0], 0, &zeros[0], 32);
    byte derived[32];
    http_tls_label(&early[0], "derived", &empty_hash[0], 32, derived, 32);
    byte handshake[32];
    hkdf_extract(Hash.SHA256, handshake, &derived[0], 32, &shared[0], 32);
    byte transcript[32];
    http_tls_snapshot(tls, transcript);
    byte client_secret[32];
    byte server_secret[32];
    http_tls_label(&handshake[0], "c hs traffic", &transcript[0], 32, client_secret, 32);
    http_tls_label(&handshake[0], "s hs traffic", &transcript[0], 32, server_secret, 32);
    http_tls_traffic(&client_secret[0], tls.client_key, tls.client_iv);
    http_tls_traffic(&server_secret[0], tls.server_key, tls.server_iv);
    tls.client_sequence = 0;
    tls.server_sequence = 0;

    Pfx *certificate = tls.certificate;
    position = http_tls_put(message, 0, 0x08000002, 4);
    position = http_tls_put(message, position, 0, 2);
    long certificate_start = position;
    position = http_tls_put(message, position, 11, 1);
    long certificate_length_at = position;
    position = http_tls_put(message, position, 0, 3);
    position = http_tls_put(message, position, 0, 1);
    long list_at = position;
    position = http_tls_put(message, position, 0, 3);
    for (int index = 0; index < certificate.certificate_count; index++) {
        long size = certificate.certificate_lengths[index];
        if (position + size + 5 > 12000) {
            break;
        }
        position = http_tls_put(message, position, size, 3);
        position = http_tls_put_bytes(message, position, &certificate.certificates[certificate.certificate_starts[index]], size);
        position = http_tls_put(message, position, 0, 2);
    }
    http_tls_put(message, list_at, position - list_at - 3, 3);
    http_tls_put(message, certificate_length_at, position - certificate_start - 4, 3);
    hash_update(tls.transcript, &message[0], position);

    http_tls_snapshot(tls, transcript);
    byte content[130];
    for (int index = 0; index < 64; index++) {
        content[index] = 32;
    }
    long content_at = http_tls_put_bytes(content, 64, as_bytes("TLS 1.3, server CertificateVerify"), 33);
    content_at = http_tls_put(content, content_at, 0, 1);
    content_at = http_tls_put_bytes(content, content_at, &transcript[0], 32);
    byte digest[32];
    hash(Hash.SHA256, digest, &content[0], content_at);
    byte signature[72];
    long signature_length = ecdsa_p256_sign(signature, &certificate.private_key[0], &digest[0]);
    if (signature_length < 0) {
        return false;
    }
    long verify_start = position;
    position = http_tls_put(message, position, 15, 1);
    position = http_tls_put(message, position, signature_length + 4, 3);
    position = http_tls_put(message, position, 0x0403, 2);
    position = http_tls_put(message, position, signature_length, 2);
    position = http_tls_put_bytes(message, position, &signature[0], signature_length);
    hash_update(tls.transcript, &message[verify_start], position - verify_start);

    byte finished_key[32];
    http_tls_label(&server_secret[0], "finished", null, 0, finished_key, 32);
    http_tls_snapshot(tls, transcript);
    byte verify[32];
    hmac(Hash.SHA256, verify, &finished_key[0], 32, &transcript[0], 32);
    long finished_start = position;
    position = http_tls_put(message, position, 20, 1);
    position = http_tls_put(message, position, 32, 3);
    position = http_tls_put_bytes(message, position, &verify[0], 32);
    hash_update(tls.transcript, &message[finished_start], position - finished_start);
    if (!http_tls_seal(worker, connection, 22, &message[0], position)) {
        return false;
    }

    http_tls_snapshot(tls, transcript);
    http_tls_label(&handshake[0], "derived", &empty_hash[0], 32, derived, 32);
    byte master[32];
    hkdf_extract(Hash.SHA256, master, &derived[0], 32, &zeros[0], 32);
    byte application[32];
    http_tls_label(&master[0], "c ap traffic", &transcript[0], 32, application, 32);
    http_tls_traffic(&application[0], tls.next_client_key, tls.next_client_iv);
    http_tls_label(&master[0], "s ap traffic", &transcript[0], 32, application, 32);
    http_tls_traffic(&application[0], tls.server_key, tls.server_iv);
    tls.server_sequence = 0;
    http_tls_label(&client_secret[0], "finished", null, 0, finished_key, 32);
    hmac(Hash.SHA256, tls.expected_finished, &finished_key[0], 32, &transcript[0], 32);
    tls.state = 1;
    return true;
}
