struct CRYPT_DATA_BLOB {
    uint size;
    byte *data;
}

extern "crypt32" long PFXImportCertStore(CRYPT_DATA_BLOB pfx, ushort *password, uint flags);
extern "crypt32" long CertEnumCertificatesInStore(long store, long previous);
extern "crypt32" long CertDuplicateCertificateContext(long context);
extern "crypt32" int CertGetCertificateContextProperty(long context, uint property, byte *data, uint *size);
extern "crypt32" int CertFreeCertificateContext(long context);
extern "crypt32" int CertCloseStore(long store, uint flags);
extern "crypt32" long CertOpenSystemStoreA(long provider, string name);
extern "crypt32" long CertFindCertificateInStore(long store, uint encoding, uint flags, uint find_type, string find, long previous);
extern "crypt32" int CryptAcquireCertificatePrivateKey(long certificate, uint flags, long parameters, long *key, uint *key_spec,
                                                       int *caller_free);
extern "ncrypt" int NCryptDeleteKey(long key, uint flags);
extern "ncrypt" int NCryptFreeObject(long handle);

const uint CERT_KEY_PROV_INFO_PROP_ID = 2;
const uint CERT_KEY_CONTEXT_PROP_ID = 5;
const uint CERT_NCRYPT_KEY_HANDLE_PROP_ID = 78;
const uint PKCS12_ALWAYS_CNG_KSP = 0x200;
const uint PKCS12_NO_PERSIST_KEY = 0x8000;
const uint CRYPT_USER_KEYSET = 0x1000;
const uint CRYPT_ACQUIRE_ONLY_NCRYPT_KEY_FLAG = 0x40000;
const uint X509_AND_PKCS7_ENCODING = 0x10001;
const uint CERT_FIND_SUBJECT_STR_A = 0x70007;
