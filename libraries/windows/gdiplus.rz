extern "gdiplus" int GdipClosePathFigure(long path);
extern "gdiplus" int GdipFillPath(long graphics, long brush, long path);
extern "gdiplus" int GdipDrawPath(long graphics, long pen, long path);
extern "gdiplus" int GdipDeletePath(long path);
extern "gdiplus" int GdipCreateFontFamilyFromName(ushort *name, long collection, long *family);
