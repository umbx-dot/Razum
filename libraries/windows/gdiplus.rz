struct GdiplusStartupInput {
    uint version;
    long debug_callback;
    int suppress_background_thread;
    int suppress_external_codecs;
}

struct RectF {
    float x;
    float y;
    float width;
    float height;
}

extern "gdiplus" int GdiplusStartup(long *token, GdiplusStartupInput input, long output);
extern "gdiplus" void GdiplusShutdown(long token);
