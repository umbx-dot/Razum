import linux;
import text;

long temp_directory(char target[]) {
    if (environment_value("TMPDIR", target) <= 0) {
        if (target.length < 6) {
            target[0] = "\0";
            return 0;
        }
        copy(target, "/tmp/");
        return 5;
    }
    long size = length(target);
    if (target[size - 1] != "/") {
        if (size + 1 >= target.length) {
            target[0] = "\0";
            return 0;
        }
        concat(target, "/");
        size++;
    }
    return size;
}
