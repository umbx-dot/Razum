import linux;

bool flush(File file) {
    if (!file.writing || file.used == 0) {
        return !file.failed;
    }
    long done = 0;
    while (done < file.used) {
        long wrote = system_call(SYS_WRITE, file.handle, (long)&file.buffer[done], file.used - done, 0);
        if (wrote == EINTR) {
            continue;
        }
        if (wrote <= 0) {
            file.failed = true;
            break;
        }
        done += wrote;
    }
    file.used = 0;
    return !file.failed;
}
