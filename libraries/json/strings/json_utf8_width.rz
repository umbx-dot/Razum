int json_utf8_width(string source, int size, int position) {
    int lead = (int)source[position];
    int width = lead < 0xE0 ? 2 : lead < 0xF0 ? 3 : 4;
    if (lead < 0xC2 || lead > 0xF4 || size - position < width) {
        return 0;
    }
    int second = (int)source[position + 1];
    if ((second & 0xC0) != 0x80 || (lead == 0xE0 && second < 0xA0) ||
        (lead == 0xED && second >= 0xA0) || (lead == 0xF0 && second < 0x90) ||
        (lead == 0xF4 && second >= 0x90)) {
        return 0;
    }
    for (int i = 2; i < width; i++) {
        if (((int)source[position + i] & 0xC0) != 0x80) {
            return 0;
        }
    }
    return width;
}
