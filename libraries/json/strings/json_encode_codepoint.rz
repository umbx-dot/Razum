int json_encode_codepoint(char *target, int value) {
    if (value < 0x80) {
        target[0] = (char)value;
        return 1;
    }
    if (value < 0x800) {
        target[0] = (char)(0xC0 | (value >> 6));
        target[1] = (char)(0x80 | (value & 0x3F));
        return 2;
    }
    if (value < 0x10000) {
        target[0] = (char)(0xE0 | (value >> 12));
        target[1] = (char)(0x80 | ((value >> 6) & 0x3F));
        target[2] = (char)(0x80 | (value & 0x3F));
        return 3;
    }
    target[0] = (char)(0xF0 | (value >> 18));
    target[1] = (char)(0x80 | ((value >> 12) & 0x3F));
    target[2] = (char)(0x80 | ((value >> 6) & 0x3F));
    target[3] = (char)(0x80 | (value & 0x3F));
    return 4;
}
