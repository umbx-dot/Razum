import json.types;
import json.strings;

int json_emit_quoted(JsonOutput *output, string value, int size, long limit) {
    char *target = output.data;
    long used = output.used;
    if (limit - used < (long)size + 2) {
        return JSON_CAPACITY;
    }
    target[used] = "\"";
    used++;
    string hex = "0123456789abcdef";
    for (int index = 0; index < size; ) {
        char current = value[index];
        if (current >= (char)0x80) {
            int width = json_utf8_width(value, size, index);
            if (width == 0) {
                return JSON_INVALID;
            }
            if (limit - used <= width) {
                return JSON_CAPACITY;
            }
            for (int i = 0; i < width; i++) {
                target[used] = value[index];
                used++;
                index++;
            }
        } else {
            int width = current < (char)0x20 ? 6 : current == "\"" || current == "\\" ? 2 : 1;
            if (limit - used <= width) {
                return JSON_CAPACITY;
            }
            if (width == 6) {
                target[used] = "\\";
                target[used + 1] = "u";
                target[used + 2] = "0";
                target[used + 3] = "0";
                target[used + 4] = hex[(int)current >> 4];
                target[used + 5] = hex[(int)current & 15];
            } else {
                if (width == 2) {
                    target[used] = "\\";
                }
                target[used + width - 1] = current;
            }
            used += width;
            index++;
        }
    }
    target[used] = "\"";
    output.used = used + 1;
    return 0;
}
