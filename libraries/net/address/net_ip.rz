import net.address.parse;
import net.address.family;
import net.types;
import text;

bool net_ip(NetAddress *address, string host, int port) {
    if (address == null) {
        return false;
    }
    address.length = 0;
    if (port < 0 || port > 65535) {
        return false;
    }
    char text[48];
    long size = length(host);
    if (size >= text.length) {
        return false;
    }
    if (equals(host, "localhost")) {
        copy(text, "127.0.0.1");
    } else if (size > 1 && host[0] == "[" && host[size - 1] == "]") {
        substring(text, host, 1, size - 2);
    } else {
        copy(text, host);
    }
    for (int index = 0; index < 28; index++) {
        address.bytes[index] = 0;
    }
    if (net_parse_ipv4(text, 0, address.bytes, 4)) {
        address.bytes[0] = (byte)net_native_family(NET_IPV4);
        address.length = 16;
    } else {
        for (int index = 4; index < 8; index++) {
            address.bytes[index] = 0;
        }
        if (!net_parse_ipv6(text, address.bytes, 8)) {
            return false;
        }
        address.bytes[0] = (byte)net_native_family(NET_IPV6);
        address.length = 28;
    }
    address.bytes[2] = (byte)(port >> 8);
    address.bytes[3] = (byte)port;
    return true;
}
