import net.types;
import winsock;

int net_peer_address(long socket, NetAddress *address) {
    if (address == null) {
        return NET_INVALID;
    }
    address.length = (int)address.bytes.length;
    int result = net_wsa_result(getpeername(socket, &address.bytes[0], &address.length));
    if (result < 0) {
        address.length = 0;
    }
    return (int)result;
}
