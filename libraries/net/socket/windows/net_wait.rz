import net.types;

int net_wait(long socket, int events, int timeout_ms) {
    if (socket < 0 || events <= 0 || events > (NET_READ | NET_WRITE) || timeout_ms < -1) {
        return NET_INVALID;
    }
    NetPollState descriptor;
    descriptor.socket = socket;
    descriptor.requested = (short)(((events & NET_READ) != 0 ? 0x0300 : 0) | ((events & NET_WRITE) != 0 ? 0x0010 : 0));
    return net_wsa_result(WSAPoll(&descriptor, 1, timeout_ms));
}
