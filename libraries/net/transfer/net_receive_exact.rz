import net.socket;
import net.types;

int net_receive_exact(long socket, byte *data, int length) {
    if (length < 0 || (length > 0 && data == null)) {
        return NET_INVALID;
    }
    int used = 0;
    while (used < length) {
        int count = net_receive(socket, &data[used], length - used);
        if (count < 0) {
            return count;
        }
        if (count == 0) {
            return used;
        }
        used += count;
    }
    return used;
}
